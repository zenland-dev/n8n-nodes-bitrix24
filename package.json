{
	"name": "@zenland-dev/n8n-nodes-bitrix24",
	"version": "0.10.0",
	"description": "Bitrix24 nodes for n8n: CRM, product catalog with prices, stock and inventory documents, tasks and workgroups, business processes, universal lists, calendar and resource booking, employees and company structure, messenger and open lines, chatbots, Drive files and folders, the event log, user agreements and consents, your own AI services, any REST method, batches, a webhook trigger and polling triggers for chats and bots",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"bitrix24",
		"bitrix",
		"crm",
		"catalog",
		"products",
		"prices",
		"inventory",
		"warehouse",
		"tasks",
		"business process",
		"workflow",
		"lists",
		"calendar",
		"events",
		"booking",
		"messenger",
		"chat",
		"open lines",
		"contact center",
		"chatbot",
		"bot",
		"drive",
		"files",
		"employees",
		"hr",
		"time tracking",
		"event log",
		"audit",
		"consent",
		"agreement",
		"ai"
	],
	"license": "MIT",
	"homepage": "https://github.com/zenland-dev/n8n-nodes-bitrix24",
	"author": {
		"name": "zenland-dev",
		"email": "zenland.dev@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zenland-dev/n8n-nodes-bitrix24.git"
	},
	"bugs": {
		"url": "https://github.com/zenland-dev/n8n-nodes-bitrix24/issues"
	},
	"engines": {
		"node": ">=20.19"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier nodes credentials shared --write",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/Bitrix24ChatbotWebhookApi.credentials.js",
			"dist/credentials/Bitrix24WebhookApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Bitrix24/Bitrix24.node.js",
			"dist/nodes/Bitrix24Ai/Bitrix24Ai.node.js",
			"dist/nodes/Bitrix24BizProc/Bitrix24BizProc.node.js",
			"dist/nodes/Bitrix24Calendar/Bitrix24Calendar.node.js",
			"dist/nodes/Bitrix24Catalog/Bitrix24Catalog.node.js",
			"dist/nodes/Bitrix24Chatbot/Bitrix24Chatbot.node.js",
			"dist/nodes/Bitrix24ChatbotTrigger/Bitrix24ChatbotTrigger.node.js",
			"dist/nodes/Bitrix24Consents/Bitrix24Consents.node.js",
			"dist/nodes/Bitrix24Crm/Bitrix24Crm.node.js",
			"dist/nodes/Bitrix24Drive/Bitrix24Drive.node.js",
			"dist/nodes/Bitrix24Employees/Bitrix24Employees.node.js",
			"dist/nodes/Bitrix24EventLog/Bitrix24EventLog.node.js",
			"dist/nodes/Bitrix24Lists/Bitrix24Lists.node.js",
			"dist/nodes/Bitrix24Messenger/Bitrix24Messenger.node.js",
			"dist/nodes/Bitrix24MessengerTrigger/Bitrix24MessengerTrigger.node.js",
			"dist/nodes/Bitrix24OpenLines/Bitrix24OpenLines.node.js",
			"dist/nodes/Bitrix24Tasks/Bitrix24Tasks.node.js",
			"dist/nodes/Bitrix24Trigger/Bitrix24Trigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.46.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "^19.0.4",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
